{
  "expo": {
    "name": "City Star",
    "slug": "city-star",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "citystar",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.citystar.pos",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "City Star uses Bluetooth to print bills on your Everycom receipt printer.",
        "NSBluetoothPeripheralUsageDescription": "City Star uses Bluetooth to print bills on your Everycom receipt printer."
      }
    },
    "android": {
      "package": "com.citystar.pos",
      "adaptiveIcon": {
        "backgroundColor": "#0E7A45",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7A45",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-thermal-printer-driver",
        {
          "bluetoothAlwaysPermission": "City Star uses Bluetooth to print bills on your Everycom receipt printer."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
